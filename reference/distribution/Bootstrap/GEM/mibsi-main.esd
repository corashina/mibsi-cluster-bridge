################################################################################
#
# MIBSI universal MHI2/MHI2Q bootstrap Green Engineering Menu
#
################################################################################

screen MIBSI Bootstrap

keyValue
    value String sys 0x00000000 0
    label "[MIBSI - MHI2/MHI2Q bootstrap v0.2.0]"
    poll 0

keyValue
    value String sys 0x00000000 0
    label "Connecter le MMI a Internet avant l'activation."
    poll 0

script
    value sys 1 0x0100 "/eso/hmi/engdefs/scripts/mibsi/v1/status.sh"
    label "Etat du bootstrap"

script
    value sys 1 0x0100 "/eso/hmi/engdefs/scripts/mibsi/v1/activate.sh"
    label "Activer ou rechercher une mise a jour"

keyValue
    value String sys 0x00000000 0
    label "La premiere version n'installe encore aucun binaire produit."
    poll 0

script
    value sys 1 0x0100 "/eso/hmi/engdefs/scripts/mibsi/v1/disable_menu.sh"
    label "Desactiver ce menu (recuperable)"
